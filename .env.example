# ==============================================================================
# VYAVASTHA — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your specific credentials.
# NEVER commit .env to version control or expose secret values.
# ==============================================================================

# Database Configuration (Turso / libSQL)
DATABASE_PROVIDER=turso
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# AI & Multimodal Perception (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Web Scraping & Fallback Extraction (Firecrawl)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Telegram Bot Ingestion (@VyavasthaMemoryBot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_father_token_here
ALLOWED_TELEGRAM_USER_ID=your_numeric_telegram_user_id
TELEGRAM_CHAT_ID=your_numeric_telegram_chat_id

# Web Application Security & Master Access
APP_MASTER_PASSWORD=your_secure_master_password_here
SESSION_SECRET=your_32_byte_random_hex_session_secret_here

# Runtime Settings
NODE_ENV=production
PORT=3000
